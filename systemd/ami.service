[Unit]
Description=ami companion daemon
Documentation=https://github.com/HasnainMSyed/ami
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/projects/ami/daemon
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run --frozen ami
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
